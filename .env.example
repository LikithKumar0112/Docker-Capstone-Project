# Copy this file to `.env` (which is gitignored) and set real values.
# Docker Compose reads `.env` automatically.

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=registryuser
POSTGRES_PASSWORD=change-me        # REQUIRED — compose will not start without it
POSTGRES_DB=registrydb

# ── Image to deploy ──────────────────────────────────────
# Jenkins overrides IMAGE_TAG with the build version (e.g. 42-a1b2c3d).
IMAGE_NAME=likith0129/registry-tracker
IMAGE_TAG=latest
